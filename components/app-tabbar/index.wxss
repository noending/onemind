.tabbar {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  max-width: 750rpx;
  bottom: 0;
  z-index: 20;
  padding: 8rpx 20rpx calc(env(safe-area-inset-bottom) + 12rpx);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1rpx solid rgba(232, 214, 192, 0.9);
  background: rgba(251, 245, 233, 0.96);
  backdrop-filter: blur(18rpx);
  box-shadow: 0 -10rpx 24rpx rgba(77, 45, 30, 0.04);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 92rpx;
  gap: 5rpx;
  border-radius: 24rpx;
  color: #876d63;
}

.tab-icon {
  width: 34rpx;
  height: 34rpx;
}

.tab-label {
  font-size: 20rpx;
  font-weight: 600;
}

.tab-item.active {
  color: #a63127;
}

.tab-item.active .tab-label {
  font-weight: 700;
}
