.shop-body {
  padding-top: 24rpx;
}

.shop-body .page-title {
  margin-top: 8rpx;
  font-size: 58rpx;
}

.shop-body .page-subtitle {
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1.35;
}

.shop-kicker {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #80655c;
  font-size: 27rpx;
  letter-spacing: 3rpx;
}

.shop-icon {
  color: #e49b31;
  font-size: 30rpx;
}

.theme-card {
  margin-top: 30rpx;
  padding: 34rpx 30rpx 32rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #aa332b, #873327);
  color: #fff8ed;
  box-shadow: 0 26rpx 60rpx rgba(132, 43, 34, 0.18);
}

.theme-label {
  display: block;
  font-size: 23rpx;
  font-weight: 700;
}

.theme-title {
  display: block;
  margin-top: 18rpx;
  font-size: 46rpx;
  font-weight: 500;
  line-height: 1.2;
}

.theme-desc {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 248, 237, 0.88);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.45;
}

.discount-row {
  margin-top: 24rpx;
  display: flex;
  gap: 22rpx;
  align-items: center;
  color: rgba(255, 248, 237, 0.88);
  font-size: 27rpx;
  font-weight: 700;
}

.discount {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f2ac3e;
  color: #351b18;
}

.shop-tabs {
  margin: 34rpx 0 24rpx;
  display: inline-flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #eee4d8;
}

.shop-tab {
  height: 56rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  color: #80655c;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 56rpx;
}

.shop-tab.active {
  background: #a63127;
  color: #fff8ed;
}

.product-card {
  margin-bottom: 20rpx;
  padding: 22rpx;
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.cover {
  position: relative;
  width: 146rpx;
  height: 146rpx;
  border-radius: 22rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.cover-image,
.thangka-image {
  width: 100%;
  height: 100%;
}

.play {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: rgba(0, 0, 0, 0.28);
  font-size: 40rpx;
}

.product-main {
  flex: 1;
  min-width: 0;
  padding-top: 2rpx;
}

.product-title-row {
  display: block;
}

.product-title-row .tag {
  height: 40rpx;
  padding: 0 14rpx;
  font-size: 22rpx;
  line-height: 40rpx;
}

.product-title {
  display: block;
  margin-top: 8rpx;
  color: #351b18;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #80655c;
  font-size: 28rpx;
  font-weight: 600;
}

.product-bottom {
  margin-top: 14rpx;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price {
  color: #a63127;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1;
}

.unit {
  color: #80655c;
  font-size: 24rpx;
  font-weight: 600;
}

.product-actions {
  width: 194rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.heart {
  width: 54rpx;
  height: 54rpx;
  border: 1rpx solid #ead8c2;
  border-radius: 50%;
  color: #80655c;
  text-align: center;
  font-size: 32rpx;
  line-height: 50rpx;
}

.product-actions .red-button {
  width: 124rpx;
  height: 56rpx;
  padding: 0;
  font-size: 25rpx;
  line-height: 56rpx;
}

.thangka-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.thangka-card {
  overflow: hidden;
}

.thangka-cover {
  position: relative;
  height: 290rpx;
  overflow: hidden;
  background: #eee4d8;
}

.thangka-tag {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  background: #f2ac3e;
  color: #351b18;
  font-size: 20rpx;
}

.thangka-heart {
  position: absolute;
  right: 14rpx;
  top: 14rpx;
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: rgba(255, 250, 242, 0.9);
  color: #80655c;
  text-align: center;
  font-size: 30rpx;
  line-height: 42rpx;
}

.thangka-copy {
  padding: 18rpx;
  display: flex;
  flex-direction: column;
}

.thangka-title {
  color: #351b18;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.25;
}

.thangka-desc,
.thangka-size {
  margin-top: 8rpx;
  color: #80655c;
  font-size: 22rpx;
  line-height: 1.35;
}

.thangka-bottom {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.small-price {
  font-size: 30rpx;
}

.rating {
  color: #80655c;
  font-size: 21rpx;
}

.thangka-button {
  margin-top: 14rpx;
  width: 100%;
}

.shop-note {
  display: block;
  margin-top: 38rpx;
  text-align: center;
  color: #80655c;
  font-size: 26rpx;
  font-weight: 600;
}
