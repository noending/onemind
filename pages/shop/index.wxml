<view class="screen">
  <view class="page-body shop-body">
    <view class="shop-title-row">
      <text class="page-title">心经记 · 商城</text>
      <view class="cart-button">
        <view class="cart-icon">
          <view class="cart-handle"></view>
          <view class="cart-basket"></view>
          <view class="cart-wheel left"></view>
          <view class="cart-wheel right"></view>
        </view>
        <text wx:if="{{cartCount > 0}}" class="cart-count">{{cartCount}}</text>
      </view>
    </view>
    <view class="shop-subtitle-row">
      <text class="page-subtitle">为修行而选 · 经文音频 · 唐卡视觉</text>
      <text class="catalog-source">{{productSourceText}}</text>
    </view>

    <view wx:if="{{featuredProduct}}" class="theme-card" data-id="{{featuredProduct.id}}" bindtap="openProduct">
      <text class="theme-label">{{featuredProduct.tag}}</text>
      <text class="theme-title">{{featuredProduct.title}}</text>
      <text class="theme-desc">{{featuredProduct.subtitle}}</text>
      <view class="discount-row">
        <text class="discount">限时 ¥{{featuredProduct.price}}</text>
        <text wx:if="{{featuredProduct.originalPrice}}" class="line-through">¥{{featuredProduct.originalPrice}}</text>
      </view>
    </view>

    <view class="shop-tabs">
      <view wx:for="{{categories}}" wx:key="*this" class="shop-tab tab-{{index}} {{activeCategory === item ? 'active' : ''}}" data-tab="{{item}}" bindtap="switchTab">
        <text class="shop-tab-text">{{item}}{{item === '收藏' && favorites.length ? ' (' + favorites.length + ')' : ''}}</text>
      </view>
    </view>

    <view class="shop-stats">
      <view wx:for="{{shopStats}}" wx:key="key" class="shop-stat-card">
        <text class="shop-stat-value">{{item.value}}</text>
        <text class="shop-stat-label">{{item.label}}</text>
        <text class="shop-stat-desc">{{item.desc}}</text>
      </view>
    </view>

    <view wx:if="{{visibleProducts.length}}">
      <view wx:for="{{visibleProducts}}" wx:key="id" class="product-card card" data-id="{{item.id}}" bindtap="openProduct">
        <view class="cover" style="background: {{item.color}};">
          <text class="cover-tag">{{item.tag}}</text>
          <text class="cover-mark">༜</text>
        </view>
        <view class="product-main">
          <text class="product-title">{{item.title}}</text>
          <text class="product-subtitle">{{item.subtitle}}</text>
          <view class="product-bottom">
            <view class="price-wrap">
              <text class="price">¥{{item.price}}</text>
              <text wx:if="{{item.originalPrice}}" class="unit line-through">¥{{item.originalPrice}}</text>
            </view>
            <view class="product-actions">
              <text class="heart {{item.isFavorite ? 'active' : ''}}" data-id="{{item.id}}" catchtap="toggleFavorite">{{item.isFavorite ? '★' : '☆'}}</text>
              <text class="card-arrow">›</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-card card">
      <text class="empty-title">该分类暂无商品</text>
      <text class="empty-desc">可以切换到其他分类，或先收藏你喜欢的内容。</text>
    </view>

    <view wx:if="{{recentViewProducts.length}}" class="record-section">
      <view class="record-head">
        <view>
          <text class="record-title">最近看过</text>
          <text class="record-desc">这些记录会跟着本地缓存一起保留。</text>
        </view>
      </view>
      <scroll-view class="recent-scroll" scroll-x="true" show-scrollbar="false">
        <view class="recent-row">
          <view wx:for="{{recentViewProducts}}" wx:key="id" class="recent-pill" data-id="{{item.id}}" bindtap="openProduct">
            <text class="recent-pill-title">{{item.title}}</text>
            <text class="recent-pill-meta">{{item.viewedAtText || item.tag}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="record-section">
      <view class="record-head">
        <view>
          <text class="record-title">{{preferencePanel.title}}</text>
          <text class="record-desc">{{preferencePanel.sourceText}}</text>
        </view>
      </view>
      <view wx:if="{{preferencePanel.records.length}}">
        <view wx:for="{{preferencePanel.records}}" wx:key="id" class="record-card card" data-id="{{item.id}}" bindtap="openProduct">
          <view class="record-main">
            <text class="record-kicker">{{item.kicker}}</text>
            <text class="record-item-title">{{item.title}}</text>
            <text class="record-item-meta">{{item.meta}}</text>
          </view>
          <text class="record-accent {{item.accentTone}}">{{item.accent}}</text>
        </view>
      </view>
      <view wx:else class="record-empty card">
        <text class="record-empty-title">还没有真实偏好记录</text>
        <text class="record-empty-desc">先看看、收藏或加购一件内容，这里就不会再是静态展示。</text>
      </view>
    </view>

    <text class="shop-note">所有内容承诺无水印 · 一次购买长期可用</text>
  </view>

  <view wx:if="{{selectedProduct}}" class="sheet-mask" bindtap="closeProduct">
    <view class="product-sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">商品详情</text>
        <text class="sheet-close" bindtap="closeProduct">×</text>
      </view>

      <view class="sheet-cover-wrap">
        <image class="sheet-cover" src="{{selectedProduct.cover}}" mode="aspectFill" />
        <text class="sheet-tag">{{selectedProduct.tag}}</text>
      </view>

      <view class="sheet-price-row">
        <text class="sheet-product-title">{{selectedProduct.title}}</text>
        <view class="sheet-price-wrap">
          <text class="sheet-price">¥{{selectedProduct.price}}</text>
          <text wx:if="{{selectedProduct.originalPrice}}" class="sheet-origin">¥{{selectedProduct.originalPrice}}</text>
        </view>
      </view>
      <text class="sheet-subtitle">{{selectedProduct.subtitle}}</text>
      <text class="sheet-desc">{{selectedProduct.description}}</text>

      <view class="sheet-features">
        <text wx:for="{{selectedProduct.features}}" wx:key="*this" class="sheet-feature">• {{item}}</text>
      </view>

      <view class="sheet-actions">
        <button class="sheet-btn ghost" bindtap="closeProduct">再看看</button>
        <button class="sheet-btn primary" bindtap="addToCart">加入购物车</button>
      </view>
    </view>
  </view>

  <app-tabbar active="shop" />
</view>
