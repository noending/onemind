.setup-screen { min-height: 100vh; background: #fffaf2; }
.setup-body { padding-top: 30rpx; padding-bottom: calc(48rpx + env(safe-area-inset-bottom)); }
.back-link { display: block; color: #80655c; font-size: 24rpx; font-weight: 600; }
.setup-body .page-title { margin-top: 20rpx; color: #351b18; font-family: "Songti SC", "STSong", serif; font-size: 48rpx; line-height: 1.2; }
.setup-body .page-subtitle { margin-top: 10rpx; color: #80655c; font-size: 24rpx; line-height: 1.5; }
.state-panel, .workload-panel { margin-top: 28rpx; padding: 24rpx; border: 1rpx solid #ead8c2; border-radius: 16rpx; background: #f7f4ee; }
.error-panel { border-color: rgba(166, 49, 39, 0.3); background: #fff4ef; }
.state-title { display: block; color: #351b18; font-size: 30rpx; font-weight: 700; }
.state-copy { display: block; margin-top: 8rpx; color: #80655c; font-size: 23rpx; line-height: 1.5; }
.section-label { display: block; margin-top: 30rpx; color: #a63127; font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.day-segmented { margin-top: 14rpx; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8rpx; }
.day-option, .minute-option { min-height: 70rpx; border: 1rpx solid #ead8c2; border-radius: 16rpx; background: #f7f4ee; color: #6d4e43; font-size: 24rpx; line-height: 1.2; }
.day-option.active, .minute-option.active { border-color: #a63127; background: #fff2e9; color: #a63127; font-weight: 700; }
.recommend-mark { display: block; margin-top: 2rpx; font-size: 18rpx; }
.custom-row { min-height: 72rpx; margin-top: 12rpx; padding: 0 18rpx; display: flex; align-items: center; gap: 10rpx; border: 1rpx solid #ead8c2; border-radius: 16rpx; background: #f7f4ee; color: #6d4e43; font-size: 24rpx; }
.custom-row input { flex: 1; min-width: 0; color: #351b18; font-size: 26rpx; text-align: right; }
.minutes-label { margin-top: 26rpx; }
.minute-options { margin-top: 14rpx; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8rpx; }
.minute-option { padding: 0 4rpx; font-size: 21rpx; }
.workload-panel { margin-top: 28rpx; background: #fff4e7; border-color: #f0d3b2; }
.workload-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8rpx; text-align: center; }
.metric-value { display: block; color: #7e2a1c; font-family: "Songti SC", "STSong", serif; font-size: 40rpx; line-height: 1.1; }
.metric-label { display: block; margin-top: 6rpx; color: #80655c; font-size: 20rpx; }
.intensity, .long-term-note { display: block; margin-top: 20rpx; color: #6d4e43; font-size: 23rpx; line-height: 1.45; }
.long-term-note { margin-top: 8rpx; color: #a63127; font-weight: 700; }
.submit-error { margin-top: 18rpx; padding: 18rpx; border: 1rpx solid rgba(166, 49, 39, 0.3); border-radius: 16rpx; background: #fff4ef; color: #7e2a1c; font-size: 23rpx; line-height: 1.45; }
.inline-button { min-height: 60rpx; margin-top: 12rpx; font-size: 23rpx; line-height: 58rpx; }
.link-button { display: block; margin: 12rpx auto 0; padding: 0; border: 0; background: transparent; color: #80655c; font-size: 22rpx; line-height: 1.4; }
.primary-button, .secondary-button { width: 100%; min-height: 82rpx; margin-top: 28rpx; padding: 0 20rpx; border-radius: 16rpx; font-size: 28rpx; font-weight: 700; line-height: 82rpx; }
.primary-button { background: #a63127; color: #fffaf2; }
.secondary-button { border: 1rpx solid #a63127; background: transparent; color: #a63127; }
.primary-button[disabled], .day-option[disabled], .minute-option[disabled] { opacity: 0.55; }
