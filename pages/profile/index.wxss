.profile-body {
  padding-top: 8rpx;
}

.hero-panel {
  position: relative;
  overflow: hidden;
  padding: 12rpx 14rpx 18rpx;
  border-radius: 40rpx;
  background: linear-gradient(180deg, rgba(244, 224, 176, 0.4), rgba(251, 245, 233, 0.2) 54%, rgba(255, 250, 242, 0));
}

.hero-mark {
  position: absolute;
  top: 18rpx;
  right: 34rpx;
  color: rgba(126, 42, 28, 0.08);
  font-size: 74rpx;
  line-height: 1;
}

.auth-card {
  position: relative;
  z-index: 1;
  margin-top: 0;
  padding: 12rpx 6rpx 0;
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.auth-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.auth-avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #8b3322, #5c1f14);
  box-shadow: 0 10rpx 20rpx rgba(83, 31, 22, 0.16);
  border: 4rpx solid rgba(251, 233, 200, 0.8);
}

.auth-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fbe9c8;
  font-size: 32rpx;
  font-weight: 700;
}

.auth-medal {
  position: absolute;
  right: -4rpx;
  bottom: -2rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e9b86a, #c58a2e);
  border: 3rpx solid #fbe9c8;
  color: #fff8ed;
  font-size: 18rpx;
  text-align: center;
  line-height: 34rpx;
  box-shadow: 0 4rpx 10rpx rgba(197, 138, 46, 0.22);
}

.auth-copy {
  flex: 1;
  min-width: 0;
  padding-top: 8rpx;
}

.auth-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.auth-name {
  display: block;
  color: #2d2018;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1.18;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.auth-level {
  height: 28rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: rgba(126, 42, 28, 0.1);
  color: #7e2a1c;
  font-size: 18rpx;
  line-height: 28rpx;
}

.auth-desc {
  display: block;
  margin-top: 8rpx;
  color: #8a7860;
  font-size: 22rpx;
  line-height: 1.35;
}

.auth-button {
  flex-shrink: 0;
  width: 50rpx;
  height: 50rpx;
  border-radius: 999rpx;
  color: rgba(138, 120, 96, 0.72);
  background: transparent;
  font-size: 38rpx;
  line-height: 50rpx;
}

.auth-button.settings {
  margin-top: 4rpx;
}

.daily-card {
  position: relative;
  z-index: 1;
  overflow: hidden;
  margin-top: 14rpx;
  padding: 22rpx 24rpx;
  border-radius: 36rpx;
  background: linear-gradient(140deg, #7e2a1c, #5c1f14);
  color: #fbe9c8;
  box-shadow: 0 10rpx 24rpx rgba(83, 31, 22, 0.12);
}

.daily-mark {
  position: absolute;
  top: 8rpx;
  right: 12rpx;
  color: rgba(251, 233, 200, 0.1);
  font-size: 72rpx;
  line-height: 1;
}

.daily-kicker {
  display: block;
  color: rgba(251, 233, 200, 0.7);
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.daily-title {
  display: block;
  margin-top: 10rpx;
  color: #fbe9c8;
  font-size: 30rpx;
  line-height: 1.55;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.daily-desc {
  display: block;
  margin-top: 8rpx;
  color: rgba(251, 233, 200, 0.6);
  font-size: 20rpx;
}

.growth-grid {
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 38rpx;
  border: 1rpx solid rgba(232, 215, 180, 0.6);
  background: rgba(255, 250, 242, 0.7);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}

.growth-card {
  min-height: 146rpx;
  padding: 26rpx 12rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 0;
  border: 0;
  border-right: 1rpx solid rgba(232, 215, 180, 0.6);
  background: transparent;
  box-shadow: none;
}

.growth-card:last-child {
  border-right: 0;
}

.growth-number {
  color: #7e2a1c;
  font-size: 46rpx;
  line-height: 1;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.growth-card:nth-child(2) .growth-number {
  color: #5e7a4f;
}

.growth-card:nth-child(3) .growth-number {
  color: #c58a2e;
}

.growth-label {
  margin-top: 10rpx;
  color: #8a7860;
  font-size: 20rpx;
}

.milestone-card {
  margin-top: 14rpx;
  padding: 22rpx 24rpx;
  border-radius: 34rpx;
  background: rgba(255, 250, 242, 0.82);
  border: 1rpx solid rgba(232, 215, 180, 0.6);
}

.milestone-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.milestone-kicker {
  color: #8a7860;
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.milestone-date {
  color: #a08464;
  font-size: 20rpx;
}

.milestone-title {
  display: block;
  margin-top: 10rpx;
  color: #2d2018;
  font-size: 32rpx;
  line-height: 1.35;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.milestone-desc {
  display: block;
  margin-top: 8rpx;
  color: #8a7860;
  font-size: 20rpx;
  line-height: 1.45;
}

.milestone-empty {
  background: rgba(255, 250, 242, 0.56);
}

.sub-tabs {
  margin-top: 18rpx;
  padding: 8rpx;
  display: flex;
  gap: 8rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(232, 215, 180, 0.4);
  background: rgba(255, 250, 242, 0.5);
}

.sub-tab {
  flex: 1;
  height: 64rpx;
  border-radius: 24rpx;
  color: #8a7860;
  font-size: 24rpx;
  line-height: 64rpx;
}

.sub-tab.active {
  background: #7e2a1c;
  color: #fbe9c8;
  box-shadow: 0 6rpx 12rpx rgba(126, 42, 28, 0.14);
}

.summary-strip {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
}

.summary-pill {
  flex: 1;
  min-width: 0;
  padding: 18rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(232, 215, 180, 0.5);
}

.summary-pill.review {
  background: rgba(126, 42, 28, 0.08);
}

.summary-pill.risk {
  background: rgba(197, 138, 46, 0.1);
}

.summary-pill.done {
  background: rgba(94, 122, 79, 0.1);
}

.summary-icon {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff8ed;
  font-size: 18rpx;
  font-weight: 700;
}

.summary-pill.review .summary-icon {
  background: #7e2a1c;
}

.summary-pill.risk .summary-icon {
  background: #c58a2e;
}

.summary-pill.done .summary-icon {
  background: #5e7a4f;
}

.summary-copy {
  flex: 1;
  min-width: 0;
}

.summary-kicker {
  display: block;
  color: #8a7860;
  font-size: 18rpx;
  line-height: 1.15;
}

.summary-value {
  display: block;
  margin-top: 6rpx;
  font-size: 30rpx;
  line-height: 1;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.summary-pill.review .summary-value {
  color: #7e2a1c;
}

.summary-pill.risk .summary-value {
  color: #c58a2e;
}

.summary-pill.done .summary-value {
  color: #5e7a4f;
}

.summary-note {
  display: block;
  margin-top: 14rpx;
  color: #8a7860;
  font-size: 22rpx;
  line-height: 1.45;
}

.goal-card {
  margin-top: 14rpx;
  padding: 22rpx 24rpx;
  border-radius: 38rpx;
  background: rgba(255, 250, 242, 0.78);
  border: 1rpx solid rgba(232, 215, 180, 0.6);
}

.goal-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.goal-main {
  flex: 1;
  min-width: 0;
}

.goal-title {
  display: block;
  color: #2d2018;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: 32rpx;
  line-height: 1.28;
}

.goal-subtitle {
  display: block;
  margin-top: 6rpx;
  color: #8a7860;
  font-size: 20rpx;
  line-height: 1.45;
}

.goal-meta {
  flex-shrink: 0;
  text-align: right;
}

.goal-target {
  display: block;
  color: #7e2a1c;
  font-size: 22rpx;
  font-weight: 700;
}

.goal-period {
  display: block;
  margin-top: 4rpx;
  color: #8a7860;
  font-size: 20rpx;
}

.goal-badges {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.goal-badge {
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #efe3cb;
  color: #8a7860;
  font-size: 18rpx;
  line-height: 36rpx;
}

.goal-badge.active {
  background: rgba(94, 122, 79, 0.14);
  color: #5e7a4f;
}

.goal-badge.muted {
  background: rgba(138, 120, 96, 0.12);
  color: #8a7860;
}

.curve-block {
  margin-top: 24rpx;
}

.curve-title {
  display: block;
  color: #8a7860;
  font-size: 22rpx;
  letter-spacing: 3rpx;
}

.curve-desc {
  display: block;
  margin-top: 8rpx;
  color: rgba(138, 120, 96, 0.7);
  font-size: 20rpx;
}

.curve-plan-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
}

.curve-plan-row {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 24rpx;
}

.curve-plan-pill {
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(232, 215, 180, 0.6);
  background: rgba(255, 250, 242, 0.7);
  color: #5c4838;
  font-size: 22rpx;
  line-height: 50rpx;
}

.curve-plan-pill.active {
  border-color: #7e2a1c;
  background: #7e2a1c;
  color: #fbe9c8;
}

.curve-card {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 38rpx;
  background: rgba(255, 250, 242, 0.72);
  border: 1rpx solid rgba(232, 215, 180, 0.6);
  box-shadow: 0 10rpx 20rpx rgba(83, 56, 36, 0.03);
}

.curve-empty {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 38rpx;
  background: rgba(255, 250, 242, 0.72);
  border: 1rpx solid rgba(232, 215, 180, 0.6);
  box-shadow: 0 10rpx 20rpx rgba(83, 56, 36, 0.03);
}

.curve-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.curve-plan-title {
  color: #7e2a1c;
  font-size: 28rpx;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.curve-plan-day {
  color: #8a7860;
  font-size: 21rpx;
}

.curve-chart-shell {
  margin-top: 16rpx;
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
}

.curve-y-axis {
  width: 58rpx;
  height: 214rpx;
  position: relative;
}

.curve-y-label {
  position: absolute;
  left: 0;
  transform: translateY(-50%);
  color: #8f7b6f;
  font-size: 18rpx;
  line-height: 1;
}

.curve-plot {
  flex: 1;
  height: 214rpx;
  position: relative;
  border-bottom: 1rpx solid #e3d5bf;
}

.curve-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.curve-guide-line {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 0;
  border-left: 2rpx dashed rgba(126, 42, 28, 0.26);
  z-index: 2;
}

.curve-x-axis {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -34rpx;
  height: 26rpx;
  z-index: 3;
}

.curve-x-label {
  position: absolute;
  transform: translateX(-50%);
  color: #8f7b6f;
  font-size: 18rpx;
  line-height: 1;
}

.curve-note-row {
  margin-top: 42rpx;
  padding: 0 20rpx;
  display: flex;
  justify-content: space-between;
}

.curve-note-node {
  width: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.curve-note-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c8beb0;
}

.curve-note-dot.active {
  background: #8f3022;
}

.curve-note-label {
  color: #b4a698;
  font-size: 17rpx;
  line-height: 1;
}

.curve-note-label.active {
  color: #8f3022;
}

.curve-empty {
  text-align: center;
}

.curve-empty-icon {
  display: block;
  color: rgba(138, 120, 96, 0.4);
  font-size: 52rpx;
  line-height: 1;
}

.curve-empty-title {
  display: block;
  margin-top: 10rpx;
  color: #8a7860;
  font-size: 24rpx;
}

.curve-empty-desc {
  display: block;
  margin-top: 8rpx;
  color: rgba(138, 120, 96, 0.7);
  font-size: 20rpx;
}

.section-head {
  margin-top: 28rpx;
  margin-bottom: 12rpx;
}

.section-title {
  margin: 0;
  color: #8a7860;
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.mini-plan-card {
  margin-bottom: 14rpx;
  padding: 24rpx;
  border-radius: 38rpx;
  background: rgba(255, 250, 242, 0.72);
  border: 1rpx solid rgba(232, 215, 180, 0.6);
  box-shadow: 0 10rpx 20rpx rgba(83, 56, 36, 0.03);
}

.mini-plan-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.mini-plan-title {
  flex: 1;
  min-width: 0;
  color: #2d2018;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: 36rpx;
  line-height: 1.22;
}

.mini-plan-title.done {
  color: #5e7a4f;
}

.mini-plan-progress {
  flex-shrink: 0;
  color: #8a7860;
  font-size: 22rpx;
}

.mini-progress-track {
  margin-top: 12rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #efe3cb;
  overflow: hidden;
}

.mini-progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: #7e2a1c;
}

.mini-progress-bar.risk {
  background: #c58a2e;
}

.mini-progress-bar.done {
  background: #5e7a4f;
}

.mini-plan-scene {
  display: block;
  margin-top: 10rpx;
  color: #8a7860;
  font-size: 22rpx;
}

.empty-card {
  margin-top: 18rpx;
  padding: 28rpx;
}

.empty-title {
  display: block;
  color: #351b18;
  font-size: 30rpx;
  font-weight: 600;
}

.empty-desc {
  display: block;
  margin-top: 10rpx;
  color: #80655c;
  font-size: 22rpx;
  line-height: 1.45;
}

.empty-button {
  margin-top: 18rpx;
  width: 168rpx;
  height: 54rpx;
  border-radius: 999rpx;
  background: #7e2a1c;
  color: #fff8ed;
  font-size: 22rpx;
  line-height: 54rpx;
}

.settings-section {
  margin-top: 18rpx;
}

.settings-card {
  margin-top: 14rpx;
  padding: 24rpx;
  border-radius: 38rpx;
  background: rgba(255, 250, 242, 0.78);
  border: 1rpx solid rgba(232, 215, 180, 0.6);
  box-shadow: 0 10rpx 20rpx rgba(83, 56, 36, 0.03);
}

.settings-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.settings-copy {
  flex: 1;
  min-width: 0;
}

.settings-title {
  display: block;
  color: #2d2018;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
}

.settings-desc {
  display: block;
  margin-top: 6rpx;
  color: #8a7860;
  font-size: 20rpx;
  line-height: 1.45;
}

.settings-action-row {
  margin-top: 18rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.settings-action {
  min-width: 176rpx;
  height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 54rpx;
  background: #efe3cb;
  color: #7e2a1c;
}

.settings-action.primary {
  background: #7e2a1c;
  color: #fff8ed;
}

.settings-action.ghost {
  background: rgba(138, 120, 96, 0.12);
  color: #6f5b45;
}

.platform-detail {
  display: block;
  margin-top: 10rpx;
  color: #a08464;
  font-size: 20rpx;
  line-height: 1.4;
}

.capability-grid {
  margin-top: 16rpx;
  display: grid;
  gap: 12rpx;
}

.capability-card {
  padding: 18rpx 18rpx 16rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.52);
  border: 1rpx solid rgba(232, 215, 180, 0.65);
}

.capability-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.capability-title {
  color: #2d2018;
  font-size: 26rpx;
  font-weight: 600;
}

.capability-status {
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  line-height: 32rpx;
}

.capability-status.available {
  background: rgba(94, 122, 79, 0.14);
  color: #5e7a4f;
}

.capability-status.ready {
  background: rgba(126, 42, 28, 0.12);
  color: #7e2a1c;
}

.capability-status.fallback {
  background: rgba(197, 138, 46, 0.14);
  color: #a86f1f;
}

.capability-desc {
  display: block;
  margin-top: 8rpx;
  color: #8a7860;
  font-size: 20rpx;
  line-height: 1.45;
}

.notification-list {
  margin-top: 12rpx;
  display: grid;
  gap: 12rpx;
}

.notification-row {
  padding: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(232, 215, 180, 0.6);
  background: rgba(255, 255, 255, 0.5);
}

.notification-main {
  flex: 1;
  min-width: 0;
}

.notification-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.notification-title {
  color: #2d2018;
  font-size: 26rpx;
  font-weight: 600;
}

.notification-status {
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  line-height: 32rpx;
}

.notification-status.on {
  background: rgba(94, 122, 79, 0.14);
  color: #5e7a4f;
}

.notification-status.off {
  background: rgba(138, 120, 96, 0.12);
  color: #8a7860;
}

.notification-desc {
  display: block;
  margin-top: 6rpx;
  color: #8a7860;
  font-size: 20rpx;
  line-height: 1.45;
}

.notification-quiet {
  display: block;
  margin-top: 6rpx;
  color: #a08464;
  font-size: 19rpx;
}

.notification-toggle {
  flex-shrink: 0;
  min-width: 88rpx;
  padding: 0 14rpx;
  height: 44rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 20rpx;
  line-height: 44rpx;
}

.notification-toggle.on {
  background: rgba(126, 42, 28, 0.12);
  color: #7e2a1c;
}

.notification-toggle.off {
  background: rgba(138, 120, 96, 0.12);
  color: #6f5b45;
}

.job-list {
  margin-top: 12rpx;
  display: grid;
  gap: 12rpx;
}

.job-row {
  padding: 18rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.48);
  border: 1rpx solid rgba(232, 215, 180, 0.55);
}

.job-main {
  flex: 1;
  min-width: 0;
}

.job-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.job-title {
  color: #2d2018;
  font-size: 26rpx;
  font-weight: 600;
}

.job-status {
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  line-height: 32rpx;
}

.job-status.pending {
  background: rgba(197, 138, 46, 0.14);
  color: #a86f1f;
}

.job-status.sent {
  background: rgba(94, 122, 79, 0.14);
  color: #5e7a4f;
}

.job-status.failed {
  background: rgba(126, 42, 28, 0.12);
  color: #7e2a1c;
}

.job-status.neutral {
  background: rgba(138, 120, 96, 0.12);
  color: #8a7860;
}

.job-meta,
.job-payload {
  display: block;
  margin-top: 6rpx;
  color: #8a7860;
  font-size: 20rpx;
  line-height: 1.45;
}

.job-time {
  flex-shrink: 0;
  color: #a08464;
  font-size: 19rpx;
  line-height: 1.4;
}

.empty-inline {
  margin-top: 12rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.48);
  text-align: center;
}

.empty-inline-text {
  color: #8a7860;
  font-size: 20rpx;
}

.checklist-list {
  margin-top: 12rpx;
  display: grid;
  gap: 12rpx;
}

.checklist-row {
  padding: 18rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(232, 215, 180, 0.55);
}

.checklist-main {
  flex: 1;
  min-width: 0;
}

.checklist-title {
  display: block;
  color: #2d2018;
  font-size: 26rpx;
  font-weight: 600;
}

.checklist-desc {
  display: block;
  margin-top: 6rpx;
  color: #8a7860;
  font-size: 20rpx;
  line-height: 1.45;
}

.checklist-side {
  flex-shrink: 0;
  text-align: right;
}

.checklist-status {
  display: block;
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  line-height: 32rpx;
}

.checklist-status.review {
  background: rgba(197, 138, 46, 0.14);
  color: #a86f1f;
}

.checklist-status.passed {
  background: rgba(94, 122, 79, 0.14);
  color: #5e7a4f;
}

.checklist-status.failed {
  background: rgba(126, 42, 28, 0.12);
  color: #7e2a1c;
}

.checklist-updated {
  display: block;
  margin-top: 6rpx;
  color: #a08464;
  font-size: 18rpx;
}

.checklist-reset {
  flex-shrink: 0;
  min-width: 88rpx;
  height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(138, 120, 96, 0.12);
  color: #6f5b45;
  font-size: 20rpx;
  line-height: 44rpx;
}

.profile-brand {
  margin-top: 28rpx;
  margin-bottom: 8rpx;
  text-align: center;
}

.brand-line {
  display: block;
  color: rgba(138, 120, 96, 0.4);
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.brand-copy {
  display: block;
  margin-top: 6rpx;
  color: rgba(138, 120, 96, 0.6);
  font-size: 20rpx;
}
