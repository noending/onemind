.profile-body {
  padding-top: 24rpx;
}

.platform-card {
  margin-top: 30rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.platform-label {
  display: block;
  color: #80655c;
  font-size: 22rpx;
  font-weight: 700;
}

.platform-title {
  display: block;
  margin-top: 8rpx;
  color: #351b18;
  font-size: 42rpx;
  font-weight: 500;
  line-height: 1.2;
}

.platform-desc {
  display: block;
  margin-top: 8rpx;
  color: #80655c;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.35;
}

.plan-button {
  flex-shrink: 0;
  width: 108rpx;
  height: 58rpx;
  border-radius: 999rpx;
  background: #a63127;
  color: #fff8ed;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 58rpx;
}

.stat-grid {
  margin-top: 32rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}

.stat-card {
  height: 168rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 34rpx;
}

.stat-icon {
  font-size: 38rpx;
  line-height: 1;
}

.stat-icon.red {
  color: #a63127;
}

.stat-icon.amber {
  color: #f19a36;
}

.stat-icon.green {
  color: #4b9b62;
}

.stat-number {
  margin-top: 8rpx;
  color: #351b18;
  font-size: 54rpx;
  line-height: 1;
}

.stat-label {
  margin-top: 8rpx;
  color: #80655c;
  font-size: 26rpx;
  font-weight: 600;
}

.reminder-card {
  padding: 30rpx;
}

.reminder-main {
  display: block;
  color: #351b18;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
}

.capability-list {
  margin-top: 22rpx;
  border-top: 1rpx solid #ead8c2;
}

.capability-row {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-bottom: 1rpx solid rgba(234, 216, 194, 0.72);
}

.capability-title {
  display: block;
  color: #351b18;
  font-size: 28rpx;
  font-weight: 700;
}

.capability-desc {
  display: block;
  margin-top: 6rpx;
  color: #80655c;
  font-size: 22rpx;
  line-height: 1.35;
}

.capability-status {
  flex-shrink: 0;
  min-width: 78rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  text-align: center;
  color: #6d4e43;
  background: #f6e4d1;
  font-size: 21rpx;
  font-weight: 700;
}

.capability-status.available {
  color: #4b9b62;
  background: rgba(75, 155, 98, 0.14);
}

.capability-status.ready {
  color: #a63127;
  background: rgba(166, 49, 39, 0.1);
}

.check-card {
  padding: 12rpx 30rpx;
}

.check-row {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx solid rgba(234, 216, 194, 0.72);
}

.check-row:last-child {
  border-bottom: 0;
}

.check-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #f2ac3e;
  flex-shrink: 0;
}

.check-copy {
  flex: 1;
  min-width: 0;
}

.check-title {
  display: block;
  color: #351b18;
  font-size: 28rpx;
  font-weight: 700;
}

.check-desc {
  display: block;
  margin-top: 6rpx;
  color: #80655c;
  font-size: 22rpx;
  line-height: 1.35;
}

.progress-card {
  margin-bottom: 20rpx;
  padding: 30rpx 30rpx 28rpx;
}

.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-title {
  color: #351b18;
  font-size: 50rpx;
  font-weight: 500;
  line-height: 1.2;
}

.progress-count {
  color: #80655c;
  font-size: 34rpx;
  font-weight: 700;
}

.progress-track {
  margin-top: 18rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #eee5da;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: #a63127;
}

.progress-bar.done {
  background: #4b9b62;
}

.progress-scene {
  display: block;
  margin-top: 16rpx;
  color: #80655c;
  font-size: 30rpx;
  font-weight: 700;
}

.reset-button {
  margin-top: 44rpx;
  height: 72rpx;
  border: 1rpx dashed #ead8c2;
  border-radius: 999rpx;
  background: transparent;
  color: #80655c;
  font-size: 28rpx;
  line-height: 70rpx;
}
