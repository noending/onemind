.train-screen {
  min-height: 100vh;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background: #fff8ed;
}

.train-header {
  padding: 0 36rpx 28rpx;
  border-bottom: 1rpx solid #ead8c2;
  background: rgba(255, 250, 242, 0.96);
}

.back-row {
  height: 56rpx;
  display: flex;
  align-items: center;
}

.back {
  color: #80655c;
  font-size: 28rpx;
  font-weight: 600;
}

.train-title-row {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.train-meta {
  display: block;
  color: #80655c;
  font-size: 26rpx;
  font-weight: 600;
}

.train-title {
  display: block;
  margin-top: 8rpx;
  color: #351b18;
  font-size: 58rpx;
  font-weight: 500;
  line-height: 1.16;
}

.audio {
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f6e4d1;
  color: #6d4e43;
  font-size: 34rpx;
}

.train-track {
  margin-top: 22rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #eee5da;
  overflow: hidden;
}

.train-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #aa332b, #873327);
}

.train-body {
  padding: 34rpx 36rpx 10rpx;
}

.segment-label {
  display: block;
  margin-bottom: 16rpx;
  color: #80655c;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  font-weight: 600;
}

.segment-card {
  margin-bottom: 16rpx;
  padding: 30rpx 26rpx;
  display: flex;
  gap: 22rpx;
  border: 1rpx solid #ead8c2;
  border-radius: 32rpx;
  background: #fffaf2;
}

.segment-card.revealed {
  background: #f7e8d2;
}

.segment-index {
  color: #80655c;
  font-size: 24rpx;
  line-height: 1.3;
}

.segment-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.segment-text {
  color: #351b18;
  font-size: 46rpx;
  line-height: 1.28;
  font-weight: 500;
}

.segment-hint {
  margin-top: 12rpx;
  color: #80655c;
  font-size: 23rpx;
}

.feedback {
  padding: 22rpx 36rpx calc(16rpx + env(safe-area-inset-bottom));
}

.feedback-label {
  display: block;
  margin-bottom: 14rpx;
  color: #80655c;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
}

.feedback-grid {
  display: flex;
  gap: 12rpx;
}

.feedback-button {
  flex: 1;
  min-width: 0;
  height: 112rpx;
  padding: 0;
  border: 1rpx solid #ead8c2;
  border-radius: 24rpx;
  background: #fffaf2;
  color: #351b18;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.25;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.feedback-button.primary {
  border-color: #a63127;
  background: linear-gradient(135deg, #aa332b, #873327);
  color: #fff8ed;
}

.feedback-button.disabled {
  opacity: 0.62;
}

.feedback-sub {
  display: block;
  margin-top: 6rpx;
  color: #80655c;
  font-size: 20rpx;
}

.feedback-sub.light {
  color: rgba(255, 248, 237, 0.82);
}

.next-card {
  margin-top: 22rpx;
  padding: 28rpx;
  border: 1rpx solid #ead8c2;
  border-radius: 30rpx;
  background: linear-gradient(160deg, #fff0d7, #f7e4cf);
}

.next-label {
  display: block;
  color: #80655c;
  font-size: 22rpx;
  font-weight: 700;
}

.next-title {
  display: block;
  margin-top: 10rpx;
  color: #351b18;
  font-size: 42rpx;
  font-weight: 500;
  line-height: 1.2;
}

.next-desc {
  display: block;
  margin-top: 10rpx;
  color: #80655c;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}

.next-button {
  margin-top: 22rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: #a63127;
  color: #fff8ed;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 64rpx;
}
