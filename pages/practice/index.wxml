<view class="screen train-screen">
  <view class="train-header" style="padding-top: {{headerTop}}px;">
    <view class="topbar">
      <text class="back" bindtap="goBack">‹ 返回</text>
      <text class="topbar-meta">{{adaptiveMode ? adaptiveStepTitle : (stepIndex + 1) + ' / ' + stepTotal + ' · ' + stepTitle}}</text>
      <button class="fulltext-button" bindtap="openFullText">查看全文</button>
    </view>
    <view class="train-progress">
      <view class="train-progress-bar" style="width: {{adaptiveMode ? adaptiveProgressPct : ((stepIndex + 1) / stepTotal) * 100}}%;"></view>
    </view>

    <view class="train-chip-row">
      <text class="train-info-chip strong">{{content.category || '经文片段'}}</text>
      <text class="train-info-chip">{{adaptiveMode ? '剩余 ' + adaptiveRemainingCount + ' 个单元' : '第 ' + currentDay + '/' + totalDays + ' 天'}}</text>
    </view>

    <view class="train-title-row">
      <view class="title-copy">
        <text class="train-mode-chip {{mode === 'playful' && !adaptiveMode ? 'playful' : ''}}">{{adaptiveMode ? '每日记忆训练' : heroLabel}}</text>
        <text class="train-title">{{adaptiveMode ? '今日记忆单元' : content.title}}</text>
        <text wx:if="{{scene && !adaptiveMode}}" class="train-scene">{{scene}}</text>
      </view>
      <view class="stage-badge">
        <text class="stage-label">{{adaptiveMode ? '状态' : '阶段'}}</text>
        <text class="stage-text">{{adaptiveMode ? (adaptiveStable ? '稳定' : '学习中') : growthStage}}</text>
      </view>
    </view>
    <text class="helper-text">{{adaptiveMode ? '一次只练一个单元，完成后由今日任务决定下一步。' : helperText}}</text>
    <view wx:if="{{showFullTextStrip}}" class="fulltext-strip {{shortFullTextStrip ? 'short' : ''}}">
      <text class="fulltext-label">全文</text>
      <scroll-view class="fulltext-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="fulltext-line">
          <view wx:for="{{fullTextUnits}}" wx:for-item="unit" wx:key="key" class="fulltext-unit {{unit.punctuation ? 'punctuation' : ''}}">
            <text class="fulltext-pinyin">{{unit.pinyin}}</text>
            <text class="fulltext-char">{{unit.text}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
    <text class="step-tip">{{adaptiveMode ? '当前步骤：' + adaptiveStepTitle : '步骤 ' + (stepIndex + 1) + ' / ' + stepTotal}}</text>
  </view>

  <block wx:if="{{adaptiveMode}}">
    <view class="train-body">
      <view wx:if="{{adaptiveLoading}}" class="adaptive-status-card">
        <text class="adaptive-status-title">正在加载今日任务</text>
        <text class="adaptive-status-body">正在同步待练单元。</text>
      </view>

      <view wx:elif="{{adaptiveError}}" class="adaptive-status-card error">
        <text class="adaptive-status-title">今日任务暂不可用</text>
        <text class="adaptive-status-body">{{adaptiveError}}</text>
        <button class="adaptive-retry-button" bindtap="retryAdaptiveLoad">重试</button>
      </view>

      <view wx:elif="{{adaptiveCompleted}}" class="adaptive-status-card complete">
        <text class="adaptive-status-title">今日任务完成</text>
        <text class="adaptive-status-body">今天的待练单元已完成，后续复习会按记忆状态安排。</text>
        <text wx:if="{{adaptiveNextDueAt}}" class="adaptive-due">下次复习：{{adaptiveNextDueAt}}</text>
      </view>

      <view wx:elif="{{adaptiveSession}}">
        <view class="adaptive-queue-head">
          <text class="segment-label">今日队列</text>
          <text class="segment-progress">剩余 {{adaptiveRemainingCount}} 个单元</text>
        </view>
        <text wx:if="{{adaptiveNextDueAt}}" class="adaptive-due">下次复习：{{adaptiveNextDueAt}}</text>
        <view class="adaptive-unit-card">
          <text class="adaptive-step-label">{{adaptiveStepTitle}}</text>
          <text class="adaptive-unit-text">{{adaptivePrompt}}</text>
          <text wx:if="{{adaptiveAnswerVisible && adaptiveSession.activeUnit.text !== adaptivePrompt}}" class="adaptive-answer">{{adaptiveSession.activeUnit.text}}</text>
          <text wx:if="{{adaptiveSession.activeMetrics.hintCount}}" class="adaptive-metrics">已使用 {{adaptiveSession.activeMetrics.hintCount}} 次提示</text>
          <text wx:if="{{adaptiveSession.activeMetrics.mistakeCount}}" class="adaptive-metrics">已标记 {{adaptiveSession.activeMetrics.mistakeCount}} 处错误</text>
        </view>
        <view wx:if="{{adaptiveSubmitError}}" class="adaptive-submit-error">
          <text>{{adaptiveSubmitError}}</text>
          <button class="adaptive-retry-button" disabled="{{adaptiveSubmitting}}" bindtap="retryAdaptiveGrade">重试提交</button>
        </view>
      </view>
    </view>

    <view wx:if="{{adaptiveSession && !adaptiveCompleted && !adaptiveLoading && !adaptiveError}}" class="adaptive-actions">
      <block wx:if="{{adaptiveSession.step === 'grade'}}">
        <text class="feedback-label">这次复现如何？</text>
        <view class="adaptive-grade-grid">
          <button class="feedback-button" disabled="{{adaptiveSubmitting}}" data-grade="again" bindtap="selectAdaptiveGrade">需加强</button>
          <button class="feedback-button" disabled="{{adaptiveSubmitting}}" data-grade="good" bindtap="selectAdaptiveGrade">基本记得</button>
          <button class="feedback-button primary" disabled="{{adaptiveSubmitting}}" data-grade="easy" bindtap="selectAdaptiveGrade">流畅复现</button>
        </view>
      </block>
      <block wx:else>
        <button wx:if="{{!adaptiveSession.activeMetrics.usedReveal && adaptiveSession.step !== 'study'}}" class="step-btn ghost" disabled="{{adaptiveSubmitting}}" bindtap="revealAdaptiveAnswer">显示答案</button>
        <button wx:if="{{adaptiveSession.step === 'check'}}" class="step-btn ghost" disabled="{{adaptiveSubmitting}}" bindtap="markAdaptiveMistake">标记一处错误</button>
        <button class="step-btn primary" disabled="{{adaptiveSubmitting}}" bindtap="advanceAdaptiveStep">{{adaptiveSession.step === 'study' ? '完成学习' : (adaptiveSession.step === 'first_character' ? '进入自由回忆' : (adaptiveSession.step === 'free_recall' ? '开始核对' : '给本次评分'))}}</button>
      </block>
    </view>
  </block>

  <block wx:else>
  <view class="train-body">
    <view wx:if="{{riskTitle}}" class="risk-card">
      <view class="risk-top">
        <text class="risk-pill">AT RISK</text>
        <text class="risk-stage">{{growthStage}}</text>
      </view>
      <text class="risk-title">{{riskTitle}}</text>
      <text class="risk-body">{{riskBody}}</text>
    </view>

    <view wx:if="{{stepIndex < stepTotal - 1}}" class="insight-card {{mode === 'playful' ? 'playful' : ''}}">
      <text class="insight-title">{{insightTitle}}</text>
      <text class="insight-body">{{insightBody}}</text>
    </view>

    <view wx:if="{{stepIndex < stepTotal - 1}}" class="segment-head">
      <text class="segment-label">{{mode === 'playful' ? '节奏卡片' : '拆段练习'}} · {{displaySegments.length}} 句</text>
      <text class="segment-progress">{{method === '拆段跟读' ? '已跟读' : '已揭开'}} {{segmentProgressCount}} / {{displaySegments.length}}</text>
    </view>

    <view wx:if="{{stepIndex < stepTotal - 1}}" wx:for="{{displaySegments}}" wx:key="i" class="segment-card {{item.revealed ? 'revealed' : ''}} {{mode === 'playful' ? 'playful' : ''}}" data-index="{{index}}" bindtap="reveal">
      <view class="segment-audio">
        <text class="segment-audio-icon">♫</text>
      </view>
      <view class="segment-copy">
        <text class="segment-index">{{index + 1}} / {{displaySegments.length}}</text>
        <view class="segment-line {{item.compact ? 'compact' : ''}}">
          <view wx:for="{{item.units}}" wx:for-item="unit" wx:key="key" class="segment-unit {{unit.hidden ? 'hidden' : ''}} {{unit.punctuation ? 'punctuation' : ''}}">
            <text class="unit-pinyin">{{unit.pinyin}}</text>
            <text class="unit-text">{{unit.text}}</text>
          </view>
        </view>
        <text wx:if="{{item.hint}}" class="segment-hint">◉ {{item.hint}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{stepIndex < stepTotal - 1}}" class="step-actions">
    <button class="step-btn ghost" bindtap="prevStep">上一步</button>
    <button class="step-btn primary {{allSegmentsReady ? '' : 'needs-review'}}" bindtap="nextStep">{{primaryStepText}}</button>
  </view>

  <view wx:if="{{stepIndex === stepTotal - 1}}" class="feedback">
    <text class="feedback-label">{{feedbackLabel}}</text>
    <view class="feedback-grid">
      <button class="feedback-button {{finished ? 'disabled' : ''}}" bindtap="needsWork">
        <text>需加强</text>
        <text class="feedback-sub">明日再练</text>
      </button>
      <button class="feedback-button {{finished ? 'disabled' : ''}}" bindtap="stronger">
        <text>{{strongerTitle}}</text>
        <text class="feedback-sub">{{strongerSub}}</text>
      </button>
      <button class="feedback-button primary wide {{mode === 'playful' ? 'playful' : ''}} {{finished ? 'disabled' : ''}}" bindtap="mastered">
        <text>{{primaryTitle}}</text>
        <text class="feedback-sub light">{{primarySub}}</text>
      </button>
    </view>

    <view wx:if="{{recommendation}}" class="next-card">
      <text class="next-label">下一段建议</text>
      <text class="next-title">{{recommendation.title}}</text>
      <text class="next-desc">{{recommendation.scene}}</text>
      <button class="next-button" bindtap="startRecommendation">开始下一段</button>
    </view>
  </view>
  </block>
</view>
