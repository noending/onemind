.library-body {
  padding-top: 124rpx;
}

.library-body .page-title {
  font-size: var(--text-display);
  line-height: var(--lh-tight);
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.library-body .page-subtitle {
  margin-top: var(--space-2);
  font-size: var(--text-xs);
  line-height: var(--lh-snug);
}

.filters {
  margin: 18rpx 0 20rpx;
  display: flex;
  gap: 8rpx;
  flex-wrap: nowrap;
  overflow-x: auto;
  white-space: nowrap;
}

.filter {
  flex-shrink: 0;
  height: var(--btn-h-sm);
  padding: 0 20rpx;
  border: 1rpx solid var(--color-border-strong);
  border-radius: var(--radius-pill);
  color: var(--color-ink-3);
  background: #f8f5ef;
  font-size: var(--text-xs);
  font-weight: 700;
  line-height: var(--btn-h-sm);
  transition: all 0.15s ease;
}

.filter.active {
  border-color: var(--color-primary-strong);
  background: var(--color-primary-strong);
  color: var(--color-on-primary);
}

.festival-filters {
  margin: -8rpx 0 18rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: nowrap;
  overflow-x: auto;
  white-space: nowrap;
}

.festival-filter {
  flex-shrink: 0;
  height: var(--btn-h-sm);
  padding: 0 18rpx;
  border-radius: var(--radius-pill);
  background: rgba(242, 172, 62, 0.12);
  color: var(--color-accent-ink);
  font-size: var(--text-xs);
  font-weight: 700;
  line-height: var(--btn-h-sm);
  border: 1rpx solid rgba(241, 154, 54, 0.2);
}

.festival-filter.active {
  background: var(--color-accent-ink);
  color: #fff7eb;
  border-color: var(--color-accent-ink);
}

.festival-spotlight {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border-radius: 34rpx;
  background: linear-gradient(145deg, rgba(255, 243, 221, 0.96), rgba(248, 233, 205, 0.92));
  border: 1rpx solid rgba(241, 154, 54, 0.18);
}

.festival-spotlight-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.festival-spotlight-kicker {
  display: block;
  color: #8b5a1e;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.4;
}

.festival-spotlight-title {
  display: block;
  margin-top: 6rpx;
  color: #351b18;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1.22;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.festival-spotlight-desc {
  display: block;
  margin-top: 8rpx;
  color: var(--color-ink-3);
  font-size: 22rpx;
  line-height: 1.5;
}

.festival-spotlight-meta {
  display: block;
  margin-top: 14rpx;
  color: var(--color-ink-3);
  font-size: 20rpx;
  line-height: 1.45;
}

.festival-clear-button {
  flex-shrink: 0;
  height: var(--btn-h-sm);
  padding: 0 20rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid rgba(166, 49, 39, 0.16);
  background: rgba(255, 250, 242, 0.9);
  color: var(--color-primary-strong);
  font-size: var(--text-xs);
  font-weight: 700;
  line-height: var(--btn-h-sm);
}

.content-card {
  margin-bottom: 14rpx;
  min-height: 184rpx;
  padding: 22rpx 24rpx;
  border-radius: 32rpx;
  background: #f7f4ee;
  border: 1rpx solid rgba(232, 216, 194, 0.9);
  box-shadow: 0 8rpx 20rpx rgba(83, 56, 36, 0.03);
}

.series-card {
  margin-bottom: 16rpx;
  padding: 26rpx;
  border-radius: 34rpx;
  background: linear-gradient(140deg, #7e2a1c, #5c1f14);
  box-shadow: 0 18rpx 40rpx rgba(126, 42, 28, 0.18);
  border: 1rpx solid rgba(251, 233, 200, 0.08);
}

.series-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.series-tag {
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(251, 233, 200, 0.16);
  color: #e9b86a;
  font-size: 20rpx;
  line-height: 34rpx;
}

.series-tag.active {
  background: rgba(94, 122, 79, 0.38);
  color: #fbe9c8;
}

.series-title {
  display: block;
  margin-top: 12rpx;
  color: #fbe9c8;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.18;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.series-subtitle {
  display: block;
  margin-top: 8rpx;
  color: rgba(251, 233, 200, 0.8);
  font-size: 22rpx;
  line-height: 1.45;
}

.series-foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.series-foot-copy {
  color: rgba(251, 233, 200, 0.74);
  font-size: 22rpx;
}

.arrow {
  color: rgba(251, 233, 200, 0.72);
  font-size: 36rpx;
  line-height: 1;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-row .tag {
  height: 34rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
  line-height: 34rpx;
}

.tag-plan {
  background: rgba(94, 122, 79, 0.14);
  color: #3f5a35;
}

.content-title {
  display: block;
  margin-top: 12rpx;
  color: #351b18;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.22;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.content-body {
  display: block;
  margin-top: var(--space-2);
  color: var(--color-ink-3);
  font-size: 22rpx;
  font-weight: 700;
  line-height: var(--lh-base);
}

.content-meta {
  margin-top: var(--space-3);
  display: block;
  color: var(--color-ink-3);
}

.content-day,
.content-scene {
  color: var(--color-ink-3);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.4;
  display: inline;
}

.content-day::after {
  content: " · ";
  color: #b7a79a;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  background: rgba(53, 27, 24, 0.3);
}

.plan-sheet {
  width: 100%;
  padding: 30rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  border-radius: 38rpx 38rpx 0 0;
  background: #fffaf2;
  box-shadow: 0 -20rpx 60rpx rgba(53, 27, 24, 0.16);
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.sheet-label {
  display: block;
  color: var(--color-ink-3);
  font-size: 24rpx;
}

.sheet-title {
  display: block;
  margin-top: 10rpx;
  color: #351b18;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1.24;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.sheet-close {
  color: #80655c;
  font-size: 48rpx;
  line-height: 1;
}

.long-tip {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(241, 154, 54, 0.32);
  border-radius: 24rpx;
  background: rgba(241, 154, 54, 0.1);
  color: #351b18;
  font-size: 25rpx;
  line-height: 1.5;
}

.sheet-plan {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #ead8c2;
  border-radius: 30rpx;
  background: linear-gradient(160deg, #fff0d7, #f7e4cf);
}

.plan-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  text-align: center;
  gap: 8rpx;
}

.metric-num {
  display: block;
  color: var(--color-primary-strong);
  font-size: 44rpx;
  font-weight: 500;
}

.metric-label {
  display: block;
  margin-top: 6rpx;
  color: var(--color-ink-3);
  font-size: 22rpx;
}

.mode-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mode-card {
  padding: 24rpx;
  display: block;
}

.mode-copy {
  flex: 1;
  min-width: 0;
}

.mode-title {
  display: block;
  color: #351b18;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.3;
}

.mode-desc {
  display: block;
  margin-top: 10rpx;
  color: var(--color-ink-3);
  font-size: 22rpx;
  line-height: 1.5;
}

.mode-button {
  width: 100%;
  margin-top: var(--space-4);
  height: var(--btn-h-md);
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  background: var(--color-primary-strong);
  color: var(--color-on-primary);
  font-size: var(--text-base);
  font-weight: 700;
  line-height: var(--btn-h-md);
}

.mode-button.light {
  background: #f2ac3e;
  color: #351b18;
}

.sheet-back {
  display: block;
  padding-top: 18rpx;
  color: var(--color-ink-3);
  text-align: center;
  font-size: 23rpx;
}
