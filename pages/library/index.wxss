.library-body {
  padding-top: 26rpx;
}

.library-body .page-title {
  font-size: 58rpx;
  line-height: 1.16;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.library-body .page-subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.42;
}

.filters {
  margin: 20rpx 0 24rpx;
  display: flex;
  gap: 8rpx;
  flex-wrap: nowrap;
  overflow-x: auto;
  white-space: nowrap;
}

.filter {
  flex-shrink: 0;
  height: 48rpx;
  padding: 0 18rpx;
  border: 1rpx solid #ead8c2;
  border-radius: 999rpx;
  color: #80655c;
  background: #f8f5ef;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 46rpx;
  transition: all 0.15s ease;
}

.filter.active {
  border-color: #a63127;
  background: #a63127;
  color: #fff8ed;
}

.content-card {
  margin-bottom: 14rpx;
  min-height: 194rpx;
  padding: 22rpx;
  border-radius: 36rpx;
  background: #f7f4ee;
  border: 1rpx solid rgba(232, 216, 194, 0.9);
  box-shadow: 0 8rpx 20rpx rgba(83, 56, 36, 0.03);
}

.series-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border-radius: 34rpx;
  background: linear-gradient(140deg, #7e2a1c, #5c1f14);
  box-shadow: 0 18rpx 40rpx rgba(126, 42, 28, 0.18);
  border: 1rpx solid rgba(251, 233, 200, 0.08);
}

.series-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.series-tag {
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(251, 233, 200, 0.16);
  color: #e9b86a;
  font-size: 20rpx;
  line-height: 34rpx;
}

.series-tag.active {
  background: rgba(94, 122, 79, 0.38);
  color: #fbe9c8;
}

.series-title {
  display: block;
  margin-top: 12rpx;
  color: #fbe9c8;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.18;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.series-subtitle {
  display: block;
  margin-top: 8rpx;
  color: rgba(251, 233, 200, 0.8);
  font-size: 22rpx;
  line-height: 1.45;
}

.series-foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.series-foot-copy {
  color: rgba(251, 233, 200, 0.74);
  font-size: 22rpx;
}

.arrow {
  color: rgba(251, 233, 200, 0.72);
  font-size: 36rpx;
  line-height: 1;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-row .tag {
  height: 34rpx;
  padding: 0 12rpx;
  font-size: 20rpx;
  line-height: 34rpx;
}

.tag-plan {
  background: rgba(94, 122, 79, 0.14);
  color: #3f5a35;
}

.content-title {
  display: block;
  margin-top: 14rpx;
  color: #351b18;
  font-size: 31rpx;
  font-weight: 500;
  line-height: 1.22;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.content-body {
  display: block;
  margin-top: 9rpx;
  color: #80655c;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.5;
}

.content-meta {
  margin-top: 12rpx;
  display: block;
  color: #8e7d71;
}

.content-day,
.content-scene {
  color: #80655c;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.4;
  display: inline;
}

.content-day::after {
  content: " · ";
  color: #b7a79a;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  background: rgba(53, 27, 24, 0.3);
}

.plan-sheet {
  width: 100%;
  padding: 34rpx 36rpx calc(58rpx + env(safe-area-inset-bottom));
  border-radius: 42rpx 42rpx 0 0;
  background: #fffaf2;
  box-shadow: 0 -20rpx 60rpx rgba(53, 27, 24, 0.16);
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.sheet-label {
  display: block;
  color: #80655c;
  font-size: 24rpx;
}

.sheet-title {
  display: block;
  margin-top: 10rpx;
  color: #351b18;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 1.24;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.sheet-close {
  color: #80655c;
  font-size: 48rpx;
  line-height: 1;
}

.long-tip {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(241, 154, 54, 0.32);
  border-radius: 24rpx;
  background: rgba(241, 154, 54, 0.1);
  color: #351b18;
  font-size: 25rpx;
  line-height: 1.5;
}

.sheet-plan {
  margin-top: 22rpx;
  padding: 28rpx 26rpx;
  border: 1rpx solid #ead8c2;
  border-radius: 30rpx;
  background: linear-gradient(160deg, #fff0d7, #f7e4cf);
}

.plan-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  text-align: center;
  gap: 8rpx;
}

.metric-num {
  display: block;
  color: #a63127;
  font-size: 44rpx;
  font-weight: 500;
}

.metric-label {
  display: block;
  margin-top: 6rpx;
  color: #80655c;
  font-size: 22rpx;
}

.mode-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mode-card {
  padding: 28rpx;
  display: block;
}

.mode-copy {
  flex: 1;
  min-width: 0;
}

.mode-title {
  display: block;
  color: #351b18;
  font-size: 29rpx;
  font-weight: 500;
  line-height: 1.3;
}

.mode-desc {
  display: block;
  margin-top: 10rpx;
  color: #80655c;
  font-size: 22rpx;
  line-height: 1.5;
}

.mode-button {
  width: 100%;
  margin-top: 18rpx;
  height: 68rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #a63127;
  color: #fff8ed;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 68rpx;
}

.mode-button.light {
  background: #f2ac3e;
  color: #351b18;
}

.sheet-back {
  display: block;
  padding-top: 18rpx;
  color: #80655c;
  text-align: center;
  font-size: 23rpx;
}
