.library-body {
  padding-top: 24rpx;
}

.filters {
  margin: 28rpx 0 42rpx;
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.filter {
  height: 58rpx;
  padding: 0 28rpx;
  border: 1rpx solid #ead8c2;
  border-radius: 999rpx;
  color: #80655c;
  background: #fffaf2;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.filter.active {
  border-color: #a63127;
  background: #a63127;
  color: #fff8ed;
}

.content-card {
  margin-bottom: 20rpx;
  padding: 30rpx 30rpx 30rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.content-title {
  display: block;
  margin-top: 24rpx;
  color: #351b18;
  font-size: 52rpx;
  font-weight: 500;
  line-height: 1.2;
}

.content-body {
  display: block;
  margin-top: 14rpx;
  color: #80655c;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
}

.content-meta {
  margin-top: 20rpx;
  display: flex;
  gap: 18rpx;
  color: #80655c;
  font-size: 30rpx;
  font-weight: 700;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  background: rgba(53, 27, 24, 0.3);
}

.plan-sheet {
  width: 100%;
  padding: 34rpx 36rpx calc(54rpx + env(safe-area-inset-bottom));
  border-radius: 44rpx 44rpx 0 0;
  background: #fffaf2;
  box-shadow: 0 -20rpx 60rpx rgba(53, 27, 24, 0.16);
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.sheet-label {
  display: block;
  color: #80655c;
  font-size: 24rpx;
}

.sheet-title {
  display: block;
  margin-top: 10rpx;
  color: #351b18;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.2;
}

.sheet-close {
  color: #80655c;
  font-size: 48rpx;
  line-height: 1;
}

.long-tip {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(241, 154, 54, 0.32);
  border-radius: 24rpx;
  background: rgba(241, 154, 54, 0.1);
  color: #351b18;
  font-size: 25rpx;
  line-height: 1.5;
}

.sheet-plan {
  margin-top: 22rpx;
  padding: 28rpx 26rpx;
  border: 1rpx solid #ead8c2;
  border-radius: 30rpx;
  background: linear-gradient(160deg, #fff0d7, #f7e4cf);
}

.plan-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  text-align: center;
}

.metric-num {
  display: block;
  color: #a63127;
  font-size: 44rpx;
  font-weight: 500;
}

.metric-label {
  display: block;
  margin-top: 6rpx;
  color: #80655c;
  font-size: 22rpx;
}

.sheet-rules {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  color: #80655c;
  font-size: 24rpx;
  line-height: 1.5;
}

.accept-button {
  margin-top: 30rpx;
  height: 92rpx;
  border-radius: 999rpx;
  background: #a63127;
  color: #fff8ed;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 92rpx;
}

.sheet-back {
  display: block;
  padding-top: 16rpx;
  color: #80655c;
  text-align: center;
  font-size: 23rpx;
}
