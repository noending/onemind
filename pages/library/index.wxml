<view class="screen">
  <view class="page-body library-body">
    <text class="page-title">选一段内容</text>
    <text class="page-subtitle">选好后系统会给你方案，无需自己设置频率</text>

    <view class="filters">
      <text wx:for="{{filters}}" wx:key="*this" class="filter {{activeFilter === item ? 'active' : ''}}" data-filter="{{item}}" bindtap="changeFilter">{{item}}</text>
    </view>

    <view wx:if="{{longSeries && (activeFilter === '全部' || activeFilter === '长咒')}}" class="series-card" bindtap="pickLongSeries">
      <view class="series-tags">
        <text class="series-tag">长咒 · 系列</text>
        <text class="series-tag">共 {{longSeries.total}} 段</text>
        <text wx:if="{{longSeries.inPlanCount > 0}}" class="series-tag active">{{longSeries.inPlanCount}} 段进行中</text>
      </view>
      <text class="series-title">{{longSeries.title}}</text>
      <text class="series-subtitle">{{longSeries.subtitle}}</text>
      <view class="series-foot">
        <text class="series-foot-copy">点击进入系列修持方案</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <view wx:if="{{loading}}" class="content-card card">
      <text class="content-title">正在载入内容</text>
      <text class="content-body">请稍候，系统正在准备可修持内容。</text>
    </view>

    <view wx:for="{{filteredContents}}" wx:key="id" class="content-card card" data-id="{{item.id}}" bindtap="pickContent">
      <view class="tag-row">
        <text class="tag">{{item.category}}</text>
        <text class="tag">{{item.lengthLabel}}</text>
        <text wx:if="{{item.supportedModes.indexOf('playful') >= 0}}" class="tag">趣味</text>
        <text wx:if="{{item.supportsRecitation}}" class="tag">读诵</text>
        <text wx:if="{{item.inPlan}}" class="tag tag-plan">已在计划中</text>
        <text wx:if="{{item.festivalTag}}" class="tag tag-strong">✣ {{item.festivalTag}}</text>
      </view>
      <text class="content-title">{{item.title}}</text>
      <text class="content-body">{{item.preview}}</text>
      <view class="content-meta">
        <text class="content-day">◷ {{item.dayText}}</text>
        <text class="content-scene">{{item.scene}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{picked}}" class="sheet-mask">
    <view class="plan-sheet">
      <view class="sheet-head">
        <view>
          <text class="sheet-label">选择修持方式</text>
          <text class="sheet-title">{{picked.title}}</text>
        </view>
        <text class="sheet-close" bindtap="closeSheet">×</text>
      </view>

      <view wx:if="{{showLongTip}}" class="long-tip">
        这是较长内容，建议先从科学背诵或日常读诵进入，再逐步推进趣味背诵。
      </view>

      <view class="sheet-plan">
        <view class="plan-metrics">
          <view>
            <text class="metric-num">{{picked.planDays}}</text>
            <text class="metric-label">建议天数</text>
          </view>
          <view>
            <text class="metric-num">{{picked.segments.length}}</text>
            <text class="metric-label">个拆段</text>
          </view>
          <view>
            <text class="metric-num">{{modeCards.length}}</text>
            <text class="metric-label">条路径</text>
          </view>
        </view>
      </view>

      <view class="mode-list">
        <view wx:for="{{modeCards}}" wx:key="key" class="mode-card card">
          <view class="mode-copy">
            <text class="mode-title">{{item.title}}</text>
            <text class="mode-desc">{{item.desc}}</text>
          </view>
          <button wx:if="{{item.key !== 'recitation'}}" class="mode-button" data-mode="{{item.key}}" bindtap="acceptPlan">{{item.button}}</button>
          <button wx:else class="mode-button light" bindtap="startRecitation">{{item.button}}</button>
        </view>
      </view>

      <text class="sheet-back" bindtap="goHome">稍后决定，先回首页</text>
    </view>
  </view>

  <app-tabbar active="library" />
</view>
