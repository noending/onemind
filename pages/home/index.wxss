.home-body {
  padding-top: 28rpx;
}

.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.date {
  display: block;
  color: #80655c;
  font-size: 26rpx;
  font-weight: 600;
}

.sync-status {
  display: block;
  margin-top: 6rpx;
  color: #a18b7f;
  font-size: 20rpx;
  line-height: 1.4;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.page-title {
  margin-top: 10rpx;
  font-size: 64rpx;
  line-height: 1.14;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.pill-button {
  height: 56rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  line-height: 56rpx;
}

.ghost-button {
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dcc7ac;
  background: rgba(255, 250, 242, 0.72);
  color: #7e2a1c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 54rpx;
}

.streak-icon {
  margin-right: 6rpx;
  font-size: 22rpx;
}

.today-card {
  position: relative;
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 42rpx;
  background: linear-gradient(140deg, #962f22, #7f271a 65%, #722114);
  color: #fbe9c8;
  box-shadow: 0 18rpx 42rpx rgba(126, 42, 28, 0.19);
  border: 1rpx solid rgba(251, 233, 200, 0.08);
}

.today-mark {
  position: absolute;
  right: 34rpx;
  top: 28rpx;
  color: rgba(234, 190, 145, 0.44);
  font-size: 40rpx;
}

.today-label {
  display: block;
  color: rgba(233, 184, 106, 0.95);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.today-verse {
  display: block;
  margin-top: 12rpx;
  font-size: 36rpx;
  line-height: 1.36;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.today-quote {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: rgba(233, 184, 106, 0.88);
  letter-spacing: 1rpx;
}

.today-next {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 28rpx;
  background: rgba(251, 233, 200, 0.12);
}

.today-next-kicker {
  display: block;
  color: rgba(233, 184, 106, 0.9);
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.today-next-title {
  display: block;
  margin-top: 8rpx;
  color: #fff4dc;
  font-size: 30rpx;
  font-weight: 600;
}

.today-next-meta {
  display: block;
  margin-top: 6rpx;
  color: rgba(251, 233, 200, 0.82);
  font-size: 22rpx;
}

.today-foot {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(251, 233, 200, 0.2);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.today-desc {
  flex: 1;
  color: rgba(251, 233, 200, 0.86);
  font-size: 26rpx;
}

.today-start {
  flex-shrink: 0;
  height: 54rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #fbe9c8;
  color: #7e2a1c;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 54rpx;
}

.list-head {
  margin: 24rpx 2rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.summary-strip {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.summary-card {
  padding: 20rpx 18rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(232, 216, 194, 0.9);
  background: rgba(255, 250, 242, 0.72);
}

.summary-card.active {
  background: #f8f0e4;
  box-shadow: 0 8rpx 18rpx rgba(83, 56, 36, 0.04);
}

.summary-count {
  display: block;
  color: #7e2a1c;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.summary-label {
  display: block;
  margin-top: 8rpx;
  color: #5c4838;
  font-size: 22rpx;
  font-weight: 700;
}

.summary-desc {
  display: block;
  margin-top: 6rpx;
  color: #8a7860;
  font-size: 20rpx;
}

.list-title {
  color: #80655c;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.list-count {
  color: #b09f94;
  font-size: 22rpx;
}

.empty-card {
  padding: 28rpx;
}

.empty-title {
  display: block;
  color: #351b18;
  font-size: 32rpx;
  font-weight: 700;
}

.empty-desc {
  display: block;
  margin-top: 10rpx;
  color: #80655c;
  font-size: 24rpx;
  line-height: 1.45;
}

.empty-button {
  margin-top: 18rpx;
  width: 168rpx;
  height: 54rpx;
  border-radius: 999rpx;
  background: #a63127;
  color: #fff8ed;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 54rpx;
}

.loading-list {
  display: grid;
  gap: 14rpx;
}

.loading-card {
  padding: 24rpx;
  border-radius: 36rpx;
  background: #f7f4ee;
  overflow: hidden;
}

.loading-line {
  height: 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(232, 216, 194, 0.55), rgba(247, 244, 238, 0.95), rgba(232, 216, 194, 0.55));
  background-size: 240rpx 100%;
  animation: shimmer 1.4s linear infinite;
}

.loading-line + .loading-line {
  margin-top: 14rpx;
}

.loading-line.short {
  width: 180rpx;
}

.loading-line.title {
  width: 300rpx;
  height: 34rpx;
}

.loading-line.body {
  width: 100%;
}

.loading-line.body.small {
  width: 72%;
}

.focus-group + .focus-group {
  margin-top: 26rpx;
}

.group-head {
  margin: 10rpx 4rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.group-title {
  display: block;
  color: #5f4639;
  font-size: 28rpx;
  font-weight: 700;
}

.group-desc {
  display: block;
  margin-top: 6rpx;
  color: #9a8579;
  font-size: 20rpx;
}

.group-button {
  flex-shrink: 0;
  height: 50rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #efe3cb;
  color: #7e2a1c;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 50rpx;
}

.review-card {
  margin-bottom: 14rpx;
  padding: 24rpx;
  border-radius: 36rpx;
  background: #f7f4ee;
  border: 1rpx solid rgba(232, 216, 194, 0.85);
  box-shadow: 0 6rpx 18rpx rgba(83, 56, 36, 0.03);
}

.review-card-hover {
  transform: scale(0.995);
  background: #f4efe7;
}

.review-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.tag-row {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tag-primary,
.tag-secondary {
  height: 34rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.tag-primary {
  background: rgba(126, 42, 28, 0.1);
  color: #7e2a1c;
}

.tag-secondary {
  background: #efe3cb;
  color: #8a7860;
}

.arrow {
  color: #b09b8e;
  font-size: 34rpx;
  line-height: 1;
}

.review-title {
  display: block;
  margin-top: 12rpx;
  color: #7e2a1c;
  font-size: 44rpx;
  font-weight: 500;
  line-height: 1.2;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.review-body {
  display: block;
  margin-top: 8rpx;
  color: #5c4838;
  font-size: 24rpx;
  line-height: 1.5;
}

.review-meta {
  display: block;
  color: #8a7860;
  font-size: 21rpx;
  line-height: 1.35;
}

.review-foot {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.review-action {
  flex-shrink: 0;
  height: 50rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #a63127;
  color: #fff8ed;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 50rpx;
}

.festival-card {
  margin-top: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border: 1rpx solid #ebcaa9;
  border-radius: 30rpx;
  background: linear-gradient(90deg, #f4d8a5, rgba(233, 184, 106, 0.8));
}

.festival-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 250, 242, 0.62);
  color: #8b3322;
  font-size: 28rpx;
}

.festival-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.festival-date {
  color: rgba(126, 42, 28, 0.8);
  font-size: 21rpx;
}

.festival-title {
  margin-top: 4rpx;
  color: #351b18;
  font-size: 32rpx;
  font-weight: 500;
  font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
}

.festival-desc {
  margin-top: 8rpx;
  color: rgba(126, 42, 28, 0.72);
  font-size: 22rpx;
  line-height: 1.4;
}

.home-note {
  display: block;
  margin: 24rpx 4rpx 0;
  color: #9a8579;
  font-size: 20rpx;
  line-height: 1.5;
}

@keyframes shimmer {
  from {
    background-position: 240rpx 0;
  }

  to {
    background-position: -240rpx 0;
  }
}

@media (max-width: 375px) {
  .summary-strip {
    grid-template-columns: 1fr;
  }

  .top-row {
    align-items: flex-start;
  }

  .top-actions {
    flex-direction: column;
    align-items: flex-end;
  }

  .today-foot,
  .review-foot,
  .group-head {
    flex-direction: column;
    align-items: flex-start;
  }
}
