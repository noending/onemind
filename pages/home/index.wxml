<view class="screen">
  <view class="page-body home-body">
    <view class="top-row">
      <view class="top-copy">
        <text class="date">{{dateLabel}}</text>
        <text class="sync-status">更新于 {{lastUpdatedText || '--:--'}} · {{sourceText}}</text>
      </view>
      <view class="top-actions">
        <button class="pill-button"><text class="streak-icon">◔</text> 连续 {{streakDays}} 天</button>
        <button class="ghost-button" bindtap="refreshToday" loading="{{refreshing}}">刷新</button>
      </view>
    </view>
    <text class="page-title">今日修持</text>

    <view class="today-card">
      <text class="today-mark">༜</text>
      <text class="today-label">TODAY · 今日偈语</text>
      <text class="today-verse">一切有为法，如梦幻泡影，</text>
      <text class="today-verse">如露亦如电，应作如是观。</text>
      <text class="today-quote">——《金刚经》四句偈</text>
      <view wx:if="{{nextDueCard}}" class="today-next">
        <text class="today-next-kicker">接下来先做</text>
        <text class="today-next-title">{{nextDueCard.title}}</text>
        <text class="today-next-meta">{{nextDueCard.metaTag}} · {{nextDueCard.methodTag}}</text>
      </view>
      <view class="today-foot">
        <text class="today-desc">{{allDone ? '今日修持已圆满' : ('今日待复习 ' + dueList.length + ' 段')}}</text>
        <button class="today-start" bindtap="startFirstDue">▶ {{allDone ? '明日预告' : '开始复习'}}</button>
      </view>
    </view>

    <view class="summary-strip">
      <view wx:for="{{summaryCards}}" wx:key="key" class="summary-card {{item.count > 0 ? 'active' : ''}}">
        <text class="summary-count">{{item.count}}</text>
        <text class="summary-label">{{item.label}}</text>
        <text class="summary-desc">{{item.desc}}</text>
      </view>
    </view>

    <view class="list-head">
      <text class="list-title">今日三类任务</text>
      <text class="list-count">{{totalFocusCount}} 项</text>
    </view>

    <view wx:if="{{loading}}" class="loading-list">
      <view class="loading-card card" wx:for="{{[1,2]}}" wx:key="*this">
        <view class="loading-line short"></view>
        <view class="loading-line title"></view>
        <view class="loading-line body"></view>
        <view class="loading-line body small"></view>
      </view>
    </view>

    <view wx:elif="{{allDone}}" class="empty-card card">
      <text class="empty-title">今日圆满</text>
      <text class="empty-desc">今天的三类任务都已清空，你也可以顺手为明天再请一段新内容。</text>
      <button class="empty-button" bindtap="goLibrary">去选内容</button>
    </view>

    <view wx:if="{{!loading}}">
      <view wx:for="{{focusGroups}}" wx:key="key" class="focus-group">
        <view class="group-head">
          <view>
            <text class="group-title">{{item.title}}</text>
            <text class="group-desc">{{item.desc}}</text>
          </view>
          <button wx:if="{{item.count > 0}}" class="group-button" data-group-key="{{item.key}}" bindtap="openFirstInGroup">先做这组</button>
          <button wx:else class="group-button ghost-group-button" data-group-key="{{item.key}}" bindtap="openGroupGuide">{{item.emptyAction}}</button>
        </view>

        <view wx:if="{{item.tasks.length > 0}}">
          <view wx:for="{{item.tasks}}" wx:key="contentId" wx:for-item="task" class="review-card card" data-id="{{task.contentId}}" data-plan-id="{{task.planId}}" data-goal-id="{{task.goalId}}" data-period="{{task.preferredPeriod}}" data-open-type="{{task.openType}}" bindtap="openDueItem" hover-class="review-card-hover">
            <view class="review-head">
              <view class="tag-row">
                <text class="tag-primary">{{task.modeTag}}</text>
                <text class="tag-secondary">{{task.metaTag}}</text>
                <text class="tag-secondary">{{task.methodTag}}</text>
              </view>
              <text class="arrow">›</text>
            </view>
            <text class="review-title">{{task.title}}</text>
            <text class="review-body">{{task.body}}</text>
            <view class="review-foot">
              <text class="review-meta">◷ {{task.meta}}</text>
              <button class="review-action" catchtap="openDueItem" data-id="{{task.contentId}}" data-plan-id="{{task.planId}}" data-goal-id="{{task.goalId}}" data-period="{{task.preferredPeriod}}" data-open-type="{{task.openType}}">{{task.actionText}}</button>
            </view>
          </view>
        </view>

        <view wx:else class="group-empty card">
          <text class="group-empty-title">{{item.emptyTitle}}</text>
          <text class="group-empty-desc">{{item.emptyDesc}}</text>
          <button class="group-empty-button" data-group-key="{{item.key}}" bindtap="openGroupGuide">{{item.emptyAction}}</button>
        </view>
      </view>
    </view>

    <view wx:if="{{featuredFestival}}" class="festival-card" bindtap="openFestival">
      <view class="festival-icon">✣</view>
      <view class="festival-copy">
        <text class="festival-date">{{featuredFestival.date}} · 节日精选</text>
        <text class="festival-title">{{featuredFestival.name}}</text>
        <text class="festival-desc">{{featuredFestival.reason || '推荐相关经咒内容'}}</text>
        <text class="festival-source">来源：{{festivalSource === 'backend' ? '后台专题' : (festivalSource === 'fallback' ? '本地兜底专题' : '本地专题')}}</text>
        <view wx:if="{{featuredFestival.recommendedContents.length > 0}}" class="festival-chip-row">
          <view
            wx:for="{{featuredFestival.recommendedContents}}"
            wx:key="id"
            wx:for-item="content"
            class="festival-chip"
            data-id="{{content.id}}"
            catchtap="openFestivalContent"
          >
            <text class="festival-chip-text">{{content.title}}</text>
          </view>
        </view>
        <button class="festival-shelf-button" catchtap="openFestivalShelf">查看专题内容</button>
      </view>
      <text class="arrow">›</text>
    </view>

    <text class="home-note">{{sourceText}} · 下拉页面也可刷新今日任务</text>
  </view>

  <app-tabbar active="home" />
</view>
